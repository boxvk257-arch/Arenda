#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Итоги по колонкам выводятся в подвале таблицы: путь к данным подвала задаётся программно.
	Элементы.ПомещенияПлощадь.ПутьКДаннымПодвала = "ИтогПоПлощади";
	Элементы.ПомещенияСумма.ПутьКДаннымПодвала = "ИтогПоСумме";
	
	ИтогПоПлощади = Объект.Помещения.Итог("Площадь");
	ИтогПоСумме = Объект.Помещения.Итог("Сумма");
	Объект.СуммаАрендыЗаМесяц = ИтогПоСумме;
	Объект.ПлощадьПоДоговору = ИтогПоПлощади;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПомещения

&НаКлиенте
Процедура ПомещенияПомещениеПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Помещения.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.Помещение) Тогда
		ДанныеПомещения = СведенияОПомещении(ТекущаяСтрока.Помещение);
		ТекущаяСтрока.Площадь = ДанныеПомещения.Площадь;
		ТекущаяСтрока.СтавкаЗаКвМ = ДанныеПомещения.СтавкаЗаКвМ;
	Иначе
		ТекущаяСтрока.Площадь = 0;
		ТекущаяСтрока.СтавкаЗаКвМ = 0;
	КонецЕсли;
	
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Площадь * ТекущаяСтрока.СтавкаЗаКвМ;
	
КонецПроцедуры

&НаКлиенте
Процедура ПомещенияПлощадьПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Помещения.ТекущиеДанные;
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Площадь * ТекущаяСтрока.СтавкаЗаКвМ;
	
КонецПроцедуры

&НаКлиенте
Процедура ПомещенияСтавкаЗаКвМПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Помещения.ТекущиеДанные;
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Площадь * ТекущаяСтрока.СтавкаЗаКвМ;
	
КонецПроцедуры

&НаКлиенте
Процедура ПомещенияПриОкончанииРедактирования(НоваяСтрока, ОтменаРедактирования)
	
	ОбновитьИтогиПомещений();
	
КонецПроцедуры

&НаКлиенте
Процедура ПомещенияПослеУдаления()
	
	ОбновитьИтогиПомещений();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьГрафик(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
		ПоказатьПредупреждение(, "Заполните дату начала договора");
		Возврат;
	КонецЕсли;
	
	Если Объект.ГрафикПлатежей.Количество() > 0 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьГрафикЗавершение", ЭтотОбъект),
			"График платежей уже заполнен. Перезаполнить?",
			РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьГрафикНаСервере();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаполнитьГрафикЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаполнитьГрафикНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтогиПомещений()
	
	СуммаПлощадей = 0;
	СуммаСтоимости = 0;
	Для Каждого СтрокаПомещения Из Объект.Помещения Цикл
		СуммаПлощадей = СуммаПлощадей + СтрокаПомещения.Площадь;
		СуммаСтоимости = СуммаСтоимости + СтрокаПомещения.Сумма;
	КонецЦикла;
	
	ИтогПоПлощади = СуммаПлощадей;
	ИтогПоСумме = СуммаСтоимости;
	Объект.СуммаАрендыЗаМесяц = СуммаСтоимости;
	Объект.ПлощадьПоДоговору = СуммаПлощадей;
	
КонецПроцедуры

&НаСервере
Функция СведенияОПомещении(Знач Помещение)
	
	Результат = Новый Структура("Площадь, СтавкаЗаКвМ", 0, 0);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Помещения.Площадь КАК Площадь,
		|	Помещения.СтавкаЗаКвМ КАК СтавкаЗаКвМ
		|ИЗ
		|	Справочник.Помещения КАК Помещения
		|ГДЕ
		|	Помещения.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Помещение);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьГрафикНаСервере()
	
	СуммаЗаМесяц = ИтогПоПомещениям();
	Если СуммаЗаМесяц = 0 Тогда
		ВывестиПредупреждение("Заполните состав помещений и ставки за кв. м");
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДатаОкончания) И Объект.ДатаОкончания < Объект.ДатаНачала Тогда
		ВывестиПредупреждение("Дата окончания договора раньше даты начала");
		Возврат;
	КонецЕсли;
	
	КоэффициентСтавкиНДС = КоэффициентНДС(Объект.СтавкаНДС);
	
	// Первый месяц неполный: сумма пропорциональна числу дней аренды в месяце начала.
	ДнейВМесяцеНачала = День(КонецМесяца(Объект.ДатаНачала));
	ДнейАрендыВМесяцеНачала = ДнейВМесяцеНачала - День(Объект.ДатаНачала) + 1;
	СуммаПервогоМесяца = Окр(СуммаЗаМесяц * ДнейАрендыВМесяцеНачала / ДнейВМесяцеНачала, 2);
	
	// Первый платеж: в месяце начала договора, но не раньше даты начала.
	ДатаПлатежа = ДеньПлатежаВМесяце(Объект.ДатаНачала, Объект.ДеньОплаты);
	Если ДатаПлатежа < Объект.ДатаНачала Тогда
		ДатаПлатежа = Объект.ДатаНачала;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		Граница = Объект.ДатаОкончания;
	Иначе
		// Бессрочный договор: 12 платежей, начиная с месяца первого платежа.
		Граница = КонецМесяца(ДобавитьМесяц(ДатаПлатежа, 11));
	КонецЕсли;
	
	Объект.ГрафикПлатежей.Очистить();
	Пока ДатаПлатежа <= Граница Цикл
		
		Если Месяц(ДатаПлатежа) = Месяц(Объект.ДатаНачала)
			И Год(ДатаПлатежа) = Год(Объект.ДатаНачала) Тогда
			СуммаПлатежа = СуммаПервогоМесяца;
		Иначе
			СуммаПлатежа = СуммаЗаМесяц;
		КонецЕсли;
		
		НоваяСтрока = Объект.ГрафикПлатежей.Добавить();
		НоваяСтрока.Период = ДатаПлатежа;
		НоваяСтрока.Сумма = СуммаПлатежа;
		НоваяСтрока.СуммаНДС = Окр(СуммаПлатежа * КоэффициентСтавкиНДС, 2);
		
		ДатаПлатежа = ДеньПлатежаВМесяце(ДобавитьМесяц(ДатаПлатежа, 1), Объект.ДеньОплаты);
		
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		ВывестиПредупреждение("Дата окончания договора не заполнена: сформировано 12 платежей");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ИтогПоПомещениям()
	
	Итог = 0;
	Для Каждого СтрокаПомещения Из Объект.Помещения Цикл
		Итог = Итог + СтрокаПомещения.Сумма;
	КонецЦикла;
	
	Возврат Итог;
	
КонецФункции

&НаСервере
Процедура ВывестиПредупреждение(Знач ТекстСообщения)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();
	
КонецПроцедуры

&НаСервере
Функция КоэффициентНДС(Знач СтавкаНДС)
	
	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС10 Тогда
		Возврат 0.1;
	КонецЕсли;
	
	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
		Возврат 0.2;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

&НаСервере
Функция ДеньПлатежаВМесяце(Знач ДатаВМесяце, Знач ДеньОплаты)
	
	ПоследнийДеньМесяца = День(КонецМесяца(ДатаВМесяце));
	ДеньПлатежа = ?(ДеньОплаты >= 1 И ДеньОплаты <= 31, ДеньОплаты, 1);
	
	Возврат Дата(Год(ДатаВМесяце), Месяц(ДатаВМесяце), Мин(ДеньПлатежа, ПоследнийДеньМесяца));
	
КонецФункции

#КонецОбласти

