#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Дата = НачалоДня(ТекущаяДатаСеанса());
	СформироватьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	
	СформироватьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СправочникПомещений.Ссылка КАК Помещение,
		|	СправочникПомещений.Площадь КАК Площадь,
		|	СправочникПомещений.Этаж КАК Этаж,
		|	ВЫБОР
		|		КОГДА Договоры.Ссылка ЕСТЬ NULL
		|			ТОГДА ""Свободно""
		|		КОГДА Договоры.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ Договоры.ДатаОкончания >= &Дата
		|			ТОГДА ""Занято""
		|		ИНАЧЕ ""Зарезервировано""
		|	КОНЕЦ КАК Состояние,
		|	Договоры.Ссылка КАК Договор,
		|	Договоры.Владелец КАК Арендатор,
		|	Договоры.ДатаНачала КАК ДатаНачала,
		|	Договоры.ДатаОкончания КАК ДатаОкончания,
		|	ВЫБОР
		|		КОГДА Договоры.Ссылка ЕСТЬ NULL
		|			ТОГДА 1
		|		КОГДА Договоры.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ Договоры.ДатаОкончания >= &Дата
		|			ТОГДА 3
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК Приоритет
		|ИЗ
		|	Справочник.Помещения КАК СправочникПомещений
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыАрендаторов.Помещения КАК СтрокиДоговоров
		|		ПО СправочникПомещений.Ссылка = СтрокиДоговоров.Помещение
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыАрендаторов КАК Договоры
		|		ПО СтрокиДоговоров.Ссылка = Договоры.Ссылка
		|			И Договоры.ДатаНачала <= &Дата
		|			И (Договоры.ДатаОкончания >= &Дата
		|				ИЛИ Договоры.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ (Договоры.Автопродление = ИСТИНА
		|					И Договоры.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровАренды.Действует)))
		|УПОРЯДОЧИТЬ ПО
		|	СправочникПомещений.Ссылка";
	Запрос.УстановитьПараметр("Дата", Дата);
	
	Данные = Запрос.Выполнить().Выгрузить();
	
	ЛучшийПриоритет = Новый Соответствие;
	Для Каждого СтрокаДанных Из Данные Цикл
		Текущий = ЛучшийПриоритет[СтрокаДанных.Помещение];
		Если Текущий = Неопределено ИЛИ СтрокаДанных.Приоритет > Текущий Тогда
			ЛучшийПриоритет.Вставить(СтрокаДанных.Помещение, СтрокаДанных.Приоритет);
		КонецЕсли;
	КонецЦикла;
	
	Результат.Очистить();
	Добавленные = Новый Соответствие;
	Для Каждого СтрокаДанных Из Данные Цикл
		Если Добавленные[СтрокаДанных.Помещение] = Истина
				ИЛИ СтрокаДанных.Приоритет <> ЛучшийПриоритет[СтрокаДанных.Помещение] Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
		Добавленные.Вставить(СтрокаДанных.Помещение, Истина);
	КонецЦикла;
	
	ПостроитьПлиткиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПостроитьПлиткиНаСервере()
	
	Если Результат.Количество() = 0 Тогда
		Плитки = "<html><head><meta charset=""utf-8""></head><body style=""margin:0px;"">"
			+ "<div style=""font-family:Arial;font-size:13px;color:#666666;padding:8px;"">Нет данных</div>"
			+ "</body></html>";
		Возврат;
	КонецЕсли;
	
	Блоки = БлокиПлиток(ТаблицаПомещенийПоЭтажам());
	
	// Единый масштаб по зданию: этаж с самой большой суммой площадей заполняет ширину целиком.
	МаксимумСуммы = 0;
	Для Каждого Блок Из Блоки Цикл
		СуммаВесов = СуммаВесовБлока(Блок);
		Если СуммаВесов > МаксимумСуммы Тогда
			МаксимумСуммы = СуммаВесов;
		КонецЕсли;
	КонецЦикла;
	
	ТекстHTML = "<html><head><meta charset=""utf-8""></head><body style=""margin:0px;"">";
	Для Каждого Блок Из Блоки Цикл
		ТекстHTML = ТекстHTML + HTMLБлокПлиток(Блок, МаксимумСуммы);
	КонецЦикла;
	ТекстHTML = ТекстHTML + "</body></html>";
	
	Плитки = ТекстHTML;
	
КонецПроцедуры

&НаСервере
Функция ТаблицаПомещенийПоЭтажам()
	
	ПомещенияПоЭтажам = Новый ТаблицаЗначений;
	ПомещенияПоЭтажам.Колонки.Добавить("ПорядокЭтажа");
	ПомещенияПоЭтажам.Колонки.Добавить("Этаж");
	ПомещенияПоЭтажам.Колонки.Добавить("Помещение");
	ПомещенияПоЭтажам.Колонки.Добавить("Площадь");
	ПомещенияПоЭтажам.Колонки.Добавить("Состояние");
	
	Для Каждого СтрокаРезультата Из Результат Цикл
		СтрокаПлитки = ПомещенияПоЭтажам.Добавить();
		СтрокаПлитки.Этаж = СтрокаРезультата.Этаж;
		СтрокаПлитки.ПорядокЭтажа = ?(ЗначениеЗаполнено(СтрокаРезультата.Этаж), 0, 1);
		СтрокаПлитки.Помещение = СтрокаРезультата.Помещение;
		СтрокаПлитки.Площадь = СтрокаРезультата.Площадь;
		СтрокаПлитки.Состояние = СтрокаРезультата.Состояние;
	КонецЦикла;
	
	ПомещенияПоЭтажам.Сортировать("ПорядокЭтажа Возр, Этаж Возр, Помещение Возр");
	
	Возврат ПомещенияПоЭтажам;
	
КонецФункции

&НаСервере
Функция БлокиПлиток(ПомещенияПоЭтажам)
	
	Блоки = Новый Массив;
	Для Каждого СтрокаПлитки Из ПомещенияПоЭтажам Цикл
		ЗаголовокЭтажа = ПредставлениеЭтажа(СтрокаПлитки.Этаж);
		Если Блоки.Количество() = 0
				ИЛИ Блоки[Блоки.ВГраница()].ЗаголовокЭтажа <> ЗаголовокЭтажа Тогда
			Блок = Новый Структура("ЗаголовокЭтажа, Строки");
			Блок.ЗаголовокЭтажа = ЗаголовокЭтажа;
			Блок.Строки = Новый Массив;
			Блоки.Добавить(Блок);
		КонецЕсли;
		Блоки[Блоки.ВГраница()].Строки.Добавить(СтрокаПлитки);
	КонецЦикла;
	
	Возврат Блоки;
	
КонецФункции

&НаСервере
Функция МинимальнаяПлощадьБлока(Блок)
	
	Минимум = 0;
	Для Каждого СтрокаПлитки Из Блок.Строки Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаПлитки.Площадь) ИЛИ СтрокаПлитки.Площадь <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Минимум = 0 ИЛИ СтрокаПлитки.Площадь < Минимум Тогда
			Минимум = СтрокаПлитки.Площадь;
		КонецЕсли;
	КонецЦикла;
	
	Если Минимум = 0 Тогда
		Возврат 1;
	КонецЕсли;
	
	Возврат Минимум;
	
КонецФункции

&НаСервере
Функция ВесСтроки(СтрокаПлитки, МинимальнаяПлощадь)
	
	Если ЗначениеЗаполнено(СтрокаПлитки.Площадь) И СтрокаПлитки.Площадь > 0 Тогда
		Возврат СтрокаПлитки.Площадь;
	КонецЕсли;
	
	Возврат МинимальнаяПлощадь;
	
КонецФункции

&НаСервере
Функция СуммаВесовБлока(Блок)
	
	МинимальнаяПлощадь = МинимальнаяПлощадьБлока(Блок);
	
	Сумма = 0;
	Для Каждого СтрокаПлитки Из Блок.Строки Цикл
		Сумма = Сумма + ВесСтроки(СтрокаПлитки, МинимальнаяПлощадь);
	КонецЦикла;
	
	Возврат Сумма;
	
КонецФункции

&НаСервере
Функция ШиринаВПроцентах(Значение, Итого)
	
	// Разделитель дробной части приводим к точке: в CSS и HTML запятая недопустима.
	Возврат СтрЗаменить(Формат(Значение / Итого * 100, "ЧДЦ=2"), ",", ".");
	
КонецФункции

&НаСервере
Функция HTMLБлокПлиток(Блок, МаксимумСуммы)
	
	МинимальнаяПлощадь = МинимальнаяПлощадьБлока(Блок);
	СуммаВесов = СуммаВесовБлока(Блок);
	
	ШиринаТаблицы = ШиринаВПроцентах(СуммаВесов, МаксимумСуммы);
	
	ТекстHTML = "<div style=""font-family:Arial;font-size:13px;font-weight:bold;color:#444444;padding:8px 2px 0px 2px;"">"
		+ ЭкранироватьHTML(Блок.ЗаголовокЭтажа) + "</div>"
		+ "<table style=""table-layout:fixed;border-collapse:separate;border-spacing:4px;width:"
		+ ШиринаТаблицы + "%;""><tr>";
	
	Для Каждого СтрокаПлитки Из Блок.Строки Цикл
		Вес = ВесСтроки(СтрокаПлитки, МинимальнаяПлощадь);
		ТекстHTML = ТекстHTML + HTMLПлитки(СтрокаПлитки, ШиринаВПроцентах(Вес, СуммаВесов));
	КонецЦикла;
	
	Возврат ТекстHTML + "</tr></table>";
	
КонецФункции

&НаСервере
Функция HTMLПлитки(СтрокаПлитки, ШиринаПроцента)
	
	Цвета = ЦветаПлитки(СтрокаПлитки.Состояние);
	
	Возврат "<td style=""width:" + ШиринаПроцента + "%;height:60px;padding:6px;vertical-align:top;overflow:hidden;"
		+ "border:1px solid " + Цвета.Рамка + ";background-color:" + Цвета.Фон + ";font-family:Arial;"">"
		+ "<div style=""font-size:13px;font-weight:bold;color:#333333;"">"
		+ ЭкранироватьHTML(СтрокаПлитки.Помещение) + "</div>"
		+ "<div style=""font-size:12px;color:#555555;padding-top:4px;"">"
		+ Формат(СтрокаПлитки.Площадь, "ЧДЦ=2") + " м&sup2;</div>"
		+ "</td>";
	
КонецФункции

&НаСервере
Функция ПредставлениеЭтажа(Этаж)
	
	Если НЕ ЗначениеЗаполнено(Этаж) Тогда
		Возврат "Этаж не указан";
	КонецЕсли;
	
	Возврат "Этаж " + Формат(Этаж, "ЧГ=0");
	
КонецФункции

&НаСервере
Функция ЦветаПлитки(Состояние)
	
	Цвета = Новый Структура("Фон, Рамка");
	
	Если Состояние = "Занято" Тогда
		Цвета.Фон = "#FFC7CE";
		Цвета.Рамка = "#E5A0A8";
	ИначеЕсли Состояние = "Зарезервировано" Тогда
		Цвета.Фон = "#FFEB9C";
		Цвета.Рамка = "#E0C464";
	ИначеЕсли Состояние = "Свободно" Тогда
		Цвета.Фон = "#C6EFCE";
		Цвета.Рамка = "#9BD3A6";
	Иначе
		Цвета.Фон = "#FFFFFF";
		Цвета.Рамка = "#CCCCCC";
	КонецЕсли;
	
	Возврат Цвета;
	
КонецФункции

&НаСервере
Функция ЭкранироватьHTML(Значение)
	
	ЗначениеСтрокой = Строка(Значение);
	ЗначениеСтрокой = СтрЗаменить(ЗначениеСтрокой, "&", "&amp;");
	ЗначениеСтрокой = СтрЗаменить(ЗначениеСтрокой, "<", "&lt;");
	ЗначениеСтрокой = СтрЗаменить(ЗначениеСтрокой, ">", "&gt;");
	ЗначениеСтрокой = СтрЗаменить(ЗначениеСтрокой, """", "&quot;");
	
	Возврат ЗначениеСтрокой;
	
КонецФункции

#КонецОбласти
