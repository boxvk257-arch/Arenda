#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Дата = НачалоДня(ТекущаяДатаСеанса());
	СформироватьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	
	СформироватьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СправочникПомещений.Ссылка КАК Помещение,
		|	СправочникПомещений.Площадь КАК Площадь,
		|	СправочникПомещений.Этаж КАК Этаж,
		|	ВЫБОР
		|		КОГДА Договоры.Ссылка ЕСТЬ NULL
		|			ТОГДА ""Свободно""
		|		КОГДА Договоры.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ Договоры.ДатаОкончания >= &Дата
		|			ТОГДА ""Занято""
		|		ИНАЧЕ ""Зарезервировано""
		|	КОНЕЦ КАК Состояние,
		|	Договоры.Ссылка КАК Договор,
		|	Договоры.Владелец КАК Арендатор,
		|	Договоры.ДатаНачала КАК ДатаНачала,
		|	Договоры.ДатаОкончания КАК ДатаОкончания,
		|	ВЫБОР
		|		КОГДА Договоры.Ссылка ЕСТЬ NULL
		|			ТОГДА 1
		|		КОГДА Договоры.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ Договоры.ДатаОкончания >= &Дата
		|			ТОГДА 3
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК Приоритет
		|ИЗ
		|	Справочник.Помещения КАК СправочникПомещений
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыАрендаторов.Помещения КАК СтрокиДоговоров
		|		ПО СправочникПомещений.Ссылка = СтрокиДоговоров.Помещение
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыАрендаторов КАК Договоры
		|		ПО СтрокиДоговоров.Ссылка = Договоры.Ссылка
		|			И Договоры.ДатаНачала <= &Дата
		|			И (Договоры.ДатаОкончания >= &Дата
		|				ИЛИ Договоры.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|				ИЛИ (Договоры.Автопродление = ИСТИНА
		|					И Договоры.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыДоговоровАренды.Действует)))
		|УПОРЯДОЧИТЬ ПО
		|	СправочникПомещений.Ссылка";
	Запрос.УстановитьПараметр("Дата", Дата);
	
	Данные = Запрос.Выполнить().Выгрузить();
	
	ЛучшийПриоритет = Новый Соответствие;
	Для Каждого СтрокаДанных Из Данные Цикл
		Текущий = ЛучшийПриоритет[СтрокаДанных.Помещение];
		Если Текущий = Неопределено ИЛИ СтрокаДанных.Приоритет > Текущий Тогда
			ЛучшийПриоритет.Вставить(СтрокаДанных.Помещение, СтрокаДанных.Приоритет);
		КонецЕсли;
	КонецЦикла;
	
	Результат.Очистить();
	Добавленные = Новый Соответствие;
	Для Каждого СтрокаДанных Из Данные Цикл
		Если Добавленные[СтрокаДанных.Помещение] = Истина
				ИЛИ СтрокаДанных.Приоритет <> ЛучшийПриоритет[СтрокаДанных.Помещение] Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
		Добавленные.Вставить(СтрокаДанных.Помещение, Истина);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
