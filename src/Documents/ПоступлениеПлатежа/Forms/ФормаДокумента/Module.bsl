#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// При выборе договора показываем только договоры выбранного арендатора.
	СвязиВыбора = Новый Массив;
	СвязиВыбора.Добавить(Новый СвязьПараметраВыбора("Отбор.Владелец", "Объект.Арендатор"));
	Элементы.Договор.СвязиПараметровВыбора = Новый ФиксированныйМассив(СвязиВыбора);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	
	ЗаполнитьПоДоговоруНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура МесяцОплатыПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.МесяцОплаты) Тогда
		Объект.МесяцОплаты = НачалоМесяца(Объект.МесяцОплаты);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтавкаНДСПриИзменении(Элемент)
	
	РассчитатьСуммуНДСНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаПриИзменении(Элемент)
	
	РассчитатьСуммуНДСНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьПоДоговоруНаСервере()
	
	Если НЕ ЗначениеЗаполнено(Объект.Договор) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ДоговорыАрендаторов.Валюта КАК Валюта,
		|	ДоговорыАрендаторов.Организация КАК Организация,
		|	ДоговорыАрендаторов.СтавкаНДС КАК СтавкаНДС
		|ИЗ
		|	Справочник.ДоговорыАрендаторов КАК ДоговорыАрендаторов
		|ГДЕ
		|	ДоговорыАрендаторов.Ссылка = &Договор";
	Запрос.УстановитьПараметр("Договор", Объект.Договор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект.Валюта = Выборка.Валюта;
		Объект.Организация = Выборка.Организация;
		Объект.СтавкаНДС = Выборка.СтавкаНДС;
	КонецЕсли;
	
	РассчитатьСуммуНДСНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммуНДСНаСервере()
	
	Объект.СуммаНДС = Окр(Объект.Сумма * КоэффициентНДС(Объект.СтавкаНДС), 2);
	
КонецПроцедуры

&НаСервере
Функция КоэффициентНДС(Знач СтавкаНДС)
	
	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС10 Тогда
		Возврат 0.1;
	КонецЕсли;
	
	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
		Возврат 0.2;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

#КонецОбласти
