#Область ОбработчикиСобытий

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ВывестиРезультат(ДокументРезультат);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВывестиРезультат(ДокументРезультат)
	
	Таблица = СформироватьТаблицу();
	
	ДокументРезультат.Очистить();
	
	Шапка = Новый Массив;
	Шапка.Добавить("Договор");
	Шапка.Добавить("Период");
	Шапка.Добавить("План");
	Шапка.Добавить("Факт");
	
	Для Колонка = 1 По Шапка.Количество() Цикл
		Область = ДокументРезультат.Область(1, Колонка, 1, Колонка);
		Область.Текст = Шапка[Колонка - 1];
	КонецЦикла;
	
	НомерСтроки = 1;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		ДокументРезультат.Область(НомерСтроки, 1, НомерСтроки, 1).Текст = Строка(СтрокаТаблицы.Договор);
		ДокументРезультат.Область(НомерСтроки, 2, НомерСтроки, 2).Текст = Формат(СтрокаТаблицы.Период, "ДЛФ=DD");
		ДокументРезультат.Область(НомерСтроки, 3, НомерСтроки, 3).Текст = Формат(СтрокаТаблицы.План, "ЧДЦ=2");
		ДокументРезультат.Область(НомерСтроки, 4, НомерСтроки, 4).Текст = Формат(СтрокаТаблицы.Факт, "ЧДЦ=2");
		
	КонецЦикла;
	
	ДокументРезультат.Область(1, 1, 1, 1).ШиринаКолонки = 35;
	ДокументРезультат.Область(1, 2, 1, 2).ШиринаКолонки = 12;
	ДокументРезультат.Область(1, 3, 1, 3).ШиринаКолонки = 15;
	ДокументРезультат.Область(1, 4, 1, 4).ШиринаКолонки = 15;
	
КонецПроцедуры

Функция СформироватьТаблицу()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.Договор КАК Договор,
		|	Т.Период КАК Период,
		|	СУММА(Т.План) КАК План,
		|	СУММА(Т.Факт) КАК Факт
		|ИЗ
		|	(ВЫБРАТЬ
		|		ГрафикПлатежей.Ссылка КАК Договор,
		|		НАЧАЛОПЕРИОДА(ГрафикПлатежей.Период, МЕСЯЦ) КАК Период,
		|		СУММА(ГрафикПлатежей.Сумма) КАК План,
		|		0 КАК Факт
		|	ИЗ
		|		Справочник.ДоговорыАрендаторов.ГрафикПлатежей КАК ГрафикПлатежей
		|	СГРУППИРОВАТЬ ПО
		|		ГрафикПлатежей.Ссылка,
		|		НАЧАЛОПЕРИОДА(ГрафикПлатежей.Период, МЕСЯЦ)
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		ПлатежиПоДоговорам.Договор,
		|		ПлатежиПоДоговорам.МесяцОплаты,
		|		0,
		|		СУММА(ПлатежиПоДоговорам.Сумма)
		|	ИЗ
		|		РегистрНакопления.ПлатежиПоДоговорам КАК ПлатежиПоДоговорам
		|	СГРУППИРОВАТЬ ПО
		|		ПлатежиПоДоговорам.Договор,
		|		ПлатежиПоДоговорам.МесяцОплаты) КАК Т
		|СГРУППИРОВАТЬ ПО
		|	Т.Договор,
		|	Т.Период
		|УПОРЯДОЧИТЬ ПО
		|	Договор,
		|	Период";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти
